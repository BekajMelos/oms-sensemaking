{
	"info": {
		"_postman_id": "9066b2a5-f056-40c7-a4a7-b8c74346f4b0",
		"name": "Sensemaking Settings API",
		"description": "API endpoints for managing Sensemaking settings with live reload",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "settings-api"
	},
	"item": [
		{
			"name": "Create or Update Setting",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Setting updated successfully\", function () {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "user_dn",
						"value": "{{WHITELIST_USER_DN}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"field_name\": \"generate_inferences\",\n    \"field_value\": true\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{SENSEMAKING_ENDPOINT}}/settings",
					"host": [
						"{{SENSEMAKING_ENDPOINT}}"
					],
					"path": [
						"settings"
					],
					"variable": []
				},
				"description": "Create or update a single setting. This will trigger a live reload of settings and restart all sensemaker controllers and RabbitMQ clients."
			},
			"response": []
		},
		{
			"name": "Create or Update Settings (Batch)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Settings updated successfully\", function () {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "user_dn",
						"value": "{{WHITELIST_USER_DN}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"settings\": {\n        \"generate_inferences\": true,\n        \"detect_loiters\": false,\n        \"detect_cotravels\": true\n    }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{SENSEMAKING_ENDPOINT}}/settings/batch",
					"host": [
						"{{SENSEMAKING_ENDPOINT}}"
					],
					"path": [
						"settings",
						"batch"
					],
					"variable": []
				},
				"description": "Create or update multiple settings at once. This will trigger a live reload of settings and restart all sensemaker controllers and RabbitMQ clients."
			},
			"response": []
		}
	]
}