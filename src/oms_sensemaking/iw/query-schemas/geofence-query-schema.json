{
  "title": "Geofence Query Config",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "queryType": { "const": "geofence" },
    "location": {
      "type": "object",
      "description": "GeoJSON Polygon fence",
      "$ref": "https://geojson.org/schema/Polygon.json"
    }
  },
  "required": ["queryType", "location"]
}
