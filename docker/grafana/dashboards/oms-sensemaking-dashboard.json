{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [],
  "templating": { "list": [] },

  "time": {
    "from": "now-15m",
    "to": "now"
  },

  "timezone": "",
  "title": "OMS Sensemaking Dashboard",
  "uid": "oms-sensemaking",
  "version": 1,

  "panels": [

    {
      "type": "row",
      "title": "API Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "type": "timeseries",
      "title": "Request Rate & p95 Response Time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(fastapi_requests_total[5m])",
          "legendFormat": "Request Rate"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, rate(fastapi_requests_duration_seconds_bucket[5m]))",
          "legendFormat": "95th Percentile Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "showPoints": "never", "lineWidth": 2 }
        }
      }
    },

    {
      "type": "row",
      "title": "Queue Processing",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },

    {
      "type": "timeseries",
      "title": "Events Processed per Second",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue_name) (rate(events_processed_total{queue_name!~\"^oms.*\"}[5m]))",
          "legendFormat": "{{queue_name}}"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Queue Processing Latency (p95)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (queue_name, le) (rate(queue_processing_time_seconds_bucket{queue_name!~\"^oms.*\"}[5m])))",
          "legendFormat": "p95 {{queue_name}}"
        }
      ]
    },

    {
      "type": "row",
      "title": "RabbitMQ Queue Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },

    {
      "type": "timeseries",
      "title": "Queue Length (Ready Messages)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready{queue!~\"^oms.*\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Unacked Messages",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_unacked{queue!~\"^oms.*\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Consumer Count",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_consumers{queue!~\"^oms.*\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "RabbitMQ Connection & Channel Churn",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(rabbitmq_connections_closed_total[5m])",
          "legendFormat": "Connections Closed"
        },
        {
          "refId": "B",
          "expr": "rate(rabbitmq_channels_closed_total[5m])",
          "legendFormat": "Channels Closed"
        }
      ]
    },

    {
      "type": "row",
      "title": "Failures",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 }
    },

    {
      "type": "timeseries",
      "title": "Event Failures per Second",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue_name) (rate(events_failed_total{queue_name!~\"^oms.*\"}[5m]))",
          "legendFormat": "{{queue_name}}"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Total Failed Events",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 52 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(events_failed_total{queue_name!~\"^oms.*\"})",
          "legendFormat": "Total"
        }
      ]
    }

  ]
}