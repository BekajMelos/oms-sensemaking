# omsb.env --- Local omsb-bridge configuration.

# --------------------------------------------------
# OMSB Service Configuration
# --------------------------------------------------
AUDIT_ON_READ=false
ENABLE_LIQUIBASE=true
OMSB_SERVICE=api
OMSB_CORS_ALLOWED_ORIGIN=https://localhost
OMSB_REQUEST_TIMEOUT_SECONDS=10
SYSTEM_USER_DN=cn=jade.meme.bia-boeing.com

# database connection - prefer .env config over this config
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=

POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_PROTOCOL=postgresql
POSTGRES_DB=omsb_db
POSTGRES_CHANGELOG=/etc/liquibase/db.changelog-main.yaml


# --------------------------------------------------
# AAC Service Configuration
# --------------------------------------------------
AAC_VERSION=2
#AAC_BASE_URL=https://proxier:443/services/aac/2.1/
AAC_BASE_URL=http://aac2:3000/
AAC_CLIENT_VALIDATE_CERT=false
PROJECT_NAME=OMS
DEFAULT_ACM_VERSION=3.0


# --------------------------------------------------
# ESS Configuration
# --------------------------------------------------
ESS_VERSION=2
ESS_BASE_URL=https://ess2:8899/
ESS_INDEXING_ENABLED=false
