## experimental use of ICE objects to encapsulate datatype properties' info
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX oms_latest_new: <http://cambridgesemantics.com/DataSource/cbd5ec538476e3efb7264e3825565c2a/>
PREFIX public: <http://cambridgesemantics.com/DataSource/cbd5ec538476e3efb7264e3825565c2a/OMS_Latest_New/public/>
PREFIX s: <http://cambridgesemantics.com/ontologies/DataToolkit#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ont: <http://blackcape.io/Model/>
PREFIX cco: <http://www.ontologyrepository.com/CommonCoreOntologies/>
 
INSERT { 
    GRAPH ${targetGraph} { 
    # Replace datatype properties with Information Content Entities that are 'about' 
    # the node object  
    
           #?datatype_property a owl:DatatypeProperty ;
           #         rdfs:comment ?attribute_type ; 
    	   #			rdfs:label ?attribute_name. 
           #?node_obj ?datatype_property ?literal_attribute_value . 
           ?node_obj rdfs:comment ?node_object_comment.
    		?ice_class a owl:Class ; 
      				rdfs:label ?literal_attribute_name ; 
      				rdfs:subClassOf ?ice_superclass . 
    		?ice_instance_obj a ?code_identifier_class ; 
       						?is_about ?node_obj ;   ## is about can be more specific according to the ICE type
                            ?is_tokenized_by ?literal_attribute_value . 
    
      
            
           
           
           
  }
}
WHERE {
    SERVICE <http://cambridgesemantics.com/services/DataToolkit> {
        ?generator a s:RdfGenerator, s:OntologyGenerator ;
            s:as (?subject ?predicate ?object) ;
            s:base ${targetGraph} ;
            .
        oms_latest_new:OMS_Latest_New a s:DbSource ;
            s:url "{{@db.cbd5ec538476e3efb7264e3825565c2a.url}}" ;
            s:username "{{@db.cbd5ec538476e3efb7264e3825565c2a.user}}" ;
            s:password "{{@db.cbd5ec538476e3efb7264e3825565c2a.password}}" ;
            s:database "{{@db.cbd5ec538476e3efb7264e3825565c2a.database}}" ;
            .
        public:attribute a s:DbSource ;
            s:using oms_latest_new:OMS_Latest_New ;
            s:table "public.attribute" ;
            s:model "attribute" ;
            s:query "select t.id as attribute_id,a.acm_string as acm_string,t.tags as tags,t.labels as labels,t.attribute_iri as attribute_iri,t.attribute_name as attribute_name,t.attribute_value as attribute_value,t.attribute_display_value as attribute_display_value,t.attribute_normalized_value as attribute_normalized_value,t.attribute_type as attribute_type,t.geometry as geometry,t.confidence as confidence,t.source_type as source_type,t.authority_value as authority_value,t.authority_set_by as authority_set_by,t.authority_set_at_time as authority_set_at_time,t.value_start as value_start,t.value_end as value_end,t.is_mutable as is_mutable,t.is_reviewed as is_reviewed,t.reviewed_by as reviewed_by,t.reviewed_at as reviewed_at,t.node_id as node_id,t.observation_id as observation_id,t.activity_id as activity_id from attribute t left join public.acm_container a on t.acm_id=a.id" ;
                #?attribute_id (xsd:string) ;
                ?acm_string (xsd:string) ;
                #?tags (xsd:list) ;
                #?labels (xsd:list) ;
                ?attribute_iri (xsd:string) ;
                ?attribute_name (xsd:string) ;
                ?attribute_value (xsd:string) ; 
                ?attribute_display_value (xsd:string) ;
                ?attribute_normalized_value (xsd:string) ;
                ?attribute_type (xsd:string) ; 
                ?geometry (xsd:string);   # may need different type here.  Revisit.
                #?confidence (xsd:string) ;
                #?source_type (xsd:string) ;
                #?authority_value (xsd:string) ;
                #?authority_set_by (xsd:string) ;
                #?authority_set_at_time (xsd:dateTime "yyyy-MM-dd HH:mm:ss.SSSZ") ;
                #?value_start (xsd:dateTime "yyyy-MM-dd HH:mm:ss.SSSZ") ; 
                #?value_end (xsd:dateTime "yyyy-MM-dd HH:mm:ss.SSSZ") ; 
                #?is_mutable (xsd:boolean) ;
                #?is_reviewed (xsd:string) ;
                #?reviewed_by (xsd:boolean) ;
                #?reviewed_at (xsd:dateTime "yyyy-MM-dd HH:mm:ss.SSSZ") ;
                ?node_id (xsd:string) ;
                #?observation_id (xsd:string) ;
                #?activity_id (xsd:string) ;
                 .
                BIND(IRI("{{?attribute_iri}}") AS ?datatype_property)
                BIND(IRI("http://blackcape.io/Model/{{?node_id}}") AS ?node_obj)
                BIND(STRDT("Formed from Attribute Mapping", xsd:string) AS ?node_object_comment)
        
    			BIND(IRI("http://www.ontologyrepository.com/CommonCoreOntologies/is_tokenized_by") as ?is_tokenized_by)

    			BIND(IRI("http://www.ontologyrepository.com/CommonCoreOntologies/is_about") as ?is_about)                
    			OPTIONAL {
                    #FILTER (?attribute_iri = "https://foundry.ai.mil/INDOPACOM/v5/Aircraft_Base_Code")
      				FILTER ( regex(?attribute_iri, "code", "i" ) )
				    BIND (xsd:string as ?attribute_xsd_type)
				    BIND ( STRDT(?attribute_value,  xsd:string )  as ?literal_attribute_value) 
				    BIND(IRI(?attribute_iri) as ?code_identifier_class)
			        BIND(IRI( "http://www.ontologyrepository.com/CommonCoreOntologies/CodeIdentifier") as ?ice_superclass)
				    BIND ( STRDT(?attribute_name,  xsd:string )  as ?literal_attribute_name) 
      				BIND(IRI(CONCAT("http://blackcape.io/Model/", MD5("{{?attribute_name}}{{attribute_value}}"))) AS ?ice_instance_obj)
  				}
    			OPTIONAL {
                    FILTER ( regex(?attribute_iri, "name", "i" ) )
				    BIND (xsd:string as ?attribute_xsd_type)
      				BIND(IRI(?attribute_iri) as ?ice_class)
				    BIND ( STRDT(?attribute_value,  xsd:string )  as ?literal_attribute_value) 
			        BIND(IRI( "http://www.ontologyrepository.com/CommonCoreOntologies/DesignativeName") as ?ice_superclass)
				    BIND ( STRDT(?attribute_name,  xsd:string )  as ?literal_attribute_name) 
      				BIND(IRI(CONCAT("http://blackcape.io/Model/", MD5("{{?attribute_name}}{{attribute_value}}"))) AS ?ice_instance_obj)
  				}    

    }
}