PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX oms_latest_new: <http://cambridgesemantics.com/DataSource/cbd5ec538476e3efb7264e3825565c2a/>
PREFIX public: <http://cambridgesemantics.com/DataSource/cbd5ec538476e3efb7264e3825565c2a/OMS_Latest_New/public/>
PREFIX s: <http://cambridgesemantics.com/ontologies/DataToolkit#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ont: <http://blackcape.io/Model/>
PREFIX cco: <http://www.ontologyrepository.com/CommonCoreOntologies/>
PREFIX dico: <http://schema.dia.mil/DefenseIntelligenceCoreOntology/>


INSERT { 
	GRAPH ${targetGraph} { 
        ?node_obj a ?node_cls .
        #ont:Node.id ?node_id ;
        #ont:Node.allegiance ?allegiance ;
        #ont:Node.allegiance_aor ?allegiance_aor ;
        #ont:Node.acm_string ?acm_string ;
        #ont:Node.labels ?labels ;
        #ont:Node.tags ?tags ;
        #ont:Node.tier ?tier ;
        #ont:Node.guide_id ?guide_id ;
        #ont:Node.is_nso ?is_nso ;
        #ont:Node.current_aor ?current_aor ;
        #ont:Node.ifc_codes ?ifc_codes ;
        #ont:Node.symbol_id_code ?symbol_id_code ;
        #ont:Node.class_iri_chain ?class_iri_chain ;
        #ont:Node.name ?name  .

        ?designates a owl:ObjectProperty.
        ?country_of_allegiance a ?country_class. 
        ?node_name_bnode a ?designative_name_class; 

      			?is_tokenized_by ?node_name_literal; 
      			?designates ?node_obj.
        ?allegiance_aor_org a ?aor_class.
        ?allegiance_aor_bnode a ?designative_name_class; 
      				?is_tokenized_by ?allegiance_aor_token; 
      				?designates ?allegiance_aor_org.
    
        
    
  }
}
WHERE {
	SERVICE <http://cambridgesemantics.com/services/DataToolkit> {
		?generator a s:RdfGenerator, s:OntologyGenerator ;
			s:as (?subject ?predicate ?object) ;
			s:base ${targetGraph} ;
			.
		oms_latest_new:OMS_Latest_New a s:DbSource ;
			s:url "{{@db.cbd5ec538476e3efb7264e3825565c2a.url}}" ;
			s:username "{{@db.cbd5ec538476e3efb7264e3825565c2a.user}}" ;
			s:password "{{@db.cbd5ec538476e3efb7264e3825565c2a.password}}" ;
			s:database "{{@db.cbd5ec538476e3efb7264e3825565c2a.database}}" ;
			.
		public:node a s:DbSource ;
			s:using oms_latest_new:OMS_Latest_New ;
			s:table "public.node" ;
			s:model "node" ;
            s:query "select n.id as node_id, n.allegiance as allegiance, n.allegiance_aor as allegiance_aor, n.class_iri as class_iri, n.class_name as class_name, a.acm_string as acm_string, n.labels as labels, n.tags as tags, n.tier as tier, n.guide_id as guide_id, n.is_nso as is_nso, n.current_aor as current_aor, n.ifc_codes as ifc_codes, n.symbol_id_code as symbol_id_code, n.class_iri_chain as class_iri_chain, n.name as name from public.node n left join public.acm_container a on n.acm_id = a.id";
            ?node_id (xsd:string);
            ?allegiance (xsd:string);
            ?allegiance_aor (xsd:string);
            ?class_iri (xsd:string);
            ?class_name (xsd:string);
            ?acm_string (xsd:string);
            ?labels (xsd:list);
            ?tags (xsd:list);
            ?tier (xsd:string);
            ?guide_id (xsd:string);
            ?is_nso (xsd:boolean);
            ?current_aor (xsd:string);
            ?ifc_codes (xsd:list);
            ?symbol_id_code (xsd:string);
            ?class_iri_chain (xsd:list);
            ?name (xsd:string);
            .  
            BIND(IRI("http://blackcape.io/Model/{{?node_id}}") AS ?node_obj) 
    		BIND(IRI("{{?class_iri}}") AS ?node_cls) 
		    BIND(IRI("http://www.ontologyrepository.com/CommonCoreOntologies/Country") as ?country_class) 
   			BIND(IRI("http://blackcape.io/Model/{{?allegiance}}") as ?country_of_allegiance) 
            BIND(IRI("http://www.ontologyrepository.com/CommonCoreOntologies/DesignativeName") as ?designative_name_class)
            BIND(IRI("http://www.ontologyrepository.com/CommonCoreOntologies/is_tokenized_by") as ?is_tokenized_by)
            BIND(STRDT(STR(?name), xsd:string) AS ?node_name_literal)
            BIND(IRI(CONCAT("http://blackcape.io/Model/", MD5("{{?name}}"))) AS ?node_name_bnode)
    		BIND(IRI("http://www.ontologyrepository.com/CommonCoreOntologies/designates") as ?designates)
            ## allegiance AOR
    		BIND(IRI("http://schema.dia.mil/DefenseIntelligenceCoreOntology/AreaOfResponsibility") as ?aor_class)
  			BIND(IRI("http://blackcape.io/Model/{{?allegiance_aor}}") AS ?allegiance_aor_org) 
            BIND(STRDT(STR(?allegiance_aor), xsd:string) AS ?allegiance_aor_token)
            BIND(IRI(CONCAT("http://blackcape.io/Model/", MD5("{{?allegiance_aor}}"))) AS ?allegiance_aor_bnode)
            
    
	}
}