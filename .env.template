# .env --- Local configuration.

# ----------------------------------------
# Sensemaker Service (Misc)
# ----------------------------------------
#APP_LOG_LEVEL="INFO"
#RELOAD_APP=1

# TLS configuration
UVICORN_SSL_KEYFILE=/opt/common/pki/server.private
UVICORN_SSL_CERTFILE=/opt/common/pki/server.public
UVICORN_SSL_CERT_REQS=0
UVICORN_PORT=8443
UVICORN_ROOT_PATH=

# ----------------------------------------
# Sensemaker Database
# ----------------------------------------

# postgres service config
POSTGRES_PORT=5432
#POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
PGUSER=appuser
PGPASSWORD=password
PGDATABASE=oms_sensemaking

# app db config
#DB_HOST=localhost
#DB_PORT=5432
#DB_SCHEMA=oms_sensemaking
#DB_USER=appuser
#DB_PASSWORD=password
#DB_SSL=true

# ----------------------------------------
# AWS SQS Settings
# ----------------------------------------
# AWS connection
#AWS_ACCESS_KEY_ID="FAKE"
#AWS_SECRET_ACCESS_KEY="FAKE"
#AWS_REGION_NAME="us-east-1"
