# SNS and SQS Settings
#SQS_GEO_QUEUE_URL="http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/geoSensemakerTrigger"


# ----------------------------------------
# Geospatial Sensemaking Settings
# ----------------------------------------
SRID=4326
CACHE_ENTRY_EXPIRE_SEC=30
POLL_PERIOD_SECONDS=10
OPERATED_BY_IRI="https://foundry.ai.mil/ontology/4901-001/operatedBy"

# Common sense filter settings
APPLY_COMMON_SENSE_FILTERS=TRUE

# Track Weaver settings
TIME_BIN_TIME_SECONDS=60
CONFIDENCE_WEIGHT_UNKNOWN=0.5
CONFIDENCE_WEIGHT_HIGH=1.0
CONFIDENCE_WEIGHT_MODERATE=0.5
CONFIDENCE_WEIGHT_LOW=0.25

# Loiter Settings
DETECT_LOITERS=True

# Cotravel Settings
DETECT_COTRAVELS=True

# Similar Track Settings
SIMILAR_TRACKS=True


# ----------------------------------------
# Inference Sensemaking Settings
# ----------------------------------------
GENERATE_INFERENCES=True
INFERENCE_TAGS='["Oms Sensemaking", "Inferred Data"]'

INFERENCE_ADD_HAS_NAME_ATTRIBUTE_IRI="https://foundry.ai.mil/ontology/4901-001/hasCommonName"
INFERENCE_ADD_HAS_NAME_ATTRIBUTE_META_DATA_IRI="https://foundry.ai.mil/MIDB_GST/v1/MDN"

INFERENCE_INCURSION_TAGS='["Oms Sensemaking", "Inferred Data", "Incursion"]'
INFERENCE_INCURSION_ATTRIBUTE_IRI="https://foundry.ai.mil/INDOPACOM/v5/Located_near"
INFERENCE_INCURSION_CLASS_IRI="http://www.ontologyrepository.com/CommonCoreOntologies/IntentionalAct"
INFERENCE_INCURSION_AREAS_OF_INTEREST_PATH="./data/areas_of_interest.json"
INFERENCE_INCURSION_ACTIVITY_STATE="UNKNOWN"

INFERENCE_GEO_ATTRIBUTE_IRI="http://www.ontologyrepository.com/CommonCoreOntologies/GeospatialLocation"
INFERENCE_GARRISONED_IN_IRI="https://foundry.ai.mil/ontology/4901-001/garrisonedIn"
INFERENCE_GARRISON_CLASS_IRI="http://www.ontologyrepository.com/CommonCoreOntologies/IntentionalAct"
INFERENCE_IN_GARRISON_ACTIVITY_NAME="In Garrison"
INFERENCE_OUT_OF_GARRISON_ACTIVITY_NAME="Out of Garrison"
INFERENCE_IN_GARRISON_ACTIVITY_STATE="IN_GARRISON"
INFERENCE_OUT_OF_GARRISON_ACTIVITY_STATE="OUT_OF_GARRISON"

# ----------------------------------------
# NLP Sensemaking Settings
