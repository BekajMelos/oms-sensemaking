# .dockerignore --- Configures files to ignore from the Docker.

# --------------------
# Generated Files
# --------------------
build
dist
htmlcov
**/*.egg-info
*.eggs
*.log
*.pyc
*.pyd
*.pyo
pytest.xml
__pycache__


# --------------------
# Project files
# --------------------
etc
docker*
!docker/*.sh
!docker/*.txt
!docker/*.py
docs
scripts
tests
venv
.*


# --------------------
# IDE Cruft
# --------------------
.idea
.vscode
.dir-locals.el
*.code-workspace
*.iml
*.swp
*.swo
*.swn


# --------------------
# Local Configuration
# --------------------
.env
.netrc
.pre-commit-config.yaml
.python-version


# --------------------
# Misc.
# --------------------
Thumbs.db
.DS_Store
*~
